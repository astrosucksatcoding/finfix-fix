{
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/tax-advisory-planning", "destination": "/tax-advisory/", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
